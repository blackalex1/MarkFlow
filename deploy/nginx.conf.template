server_tokens off;
charset utf-8;

# Always redirect HTTP to HTTPS
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        allow all;
    }

    location / {
        # Redirect to HTTPS, including the custom port if specified
        return 301 "https://$host:{{HTTPS_PORT}}$request_uri";
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name {{DOMAIN_NAME}};

    ssl_certificate /etc/letsencrypt/live/{{DOMAIN_NAME}}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{DOMAIN_NAME}}/privkey.pem;

    # These files are downloaded by init-letsencrypt.sh
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Use Docker DNS resolver for dynamic upstream resolution
    resolver 127.0.0.11 valid=30s;

    location / {
        # Using a variable forces Nginx to resolve the hostname at runtime
        # instead of failing to start if the container isn't ready yet.
        set $upstream markflow:8000;
        proxy_pass http://$upstream;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host:$server_port;
        
        # WebSocket support
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        client_max_body_size 100M;
    }

    location /config/ {
        set $upstream markflow:8000;
        proxy_pass http://$upstream/config/;
    }
}

